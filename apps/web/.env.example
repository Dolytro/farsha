# Google Cloud: OAuth client ID (Web application) and a browser API key restricted to your site.
# Both values are public in the built app; there is no client secret.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics at all.
# Visitors are asked first and nothing loads until they accept.
VITE_GA_ID=
