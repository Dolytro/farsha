  "homepage": "https://farsha-design.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dolytro/farsha.git"
  },
  "bugs": {
    "url": "https://github.com/Dolytro/farsha/issues"
  },
  "funding": {
    "type": "buymeacoffee",
